<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.campbooking.g.mapper.RedemptionCodeMapper">

    <resultMap id="BaseResultMap" type="com.example.campbooking.g.entity.RedemptionCode">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="type" property="type"/>
        <result column="value" property="value"/>
        <result column="used" property="used"/>
        <result column="used_by" property="usedBy"/>
        <result column="used_at" property="usedAt"/>
        <result column="expire_at" property="expireAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByCode" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT id, code, type, value, used, used_by, used_at, expire_at, created_at
        FROM redemption_codes
        WHERE code = #{code}
        LIMIT 1
    </select>

    <update id="markUsed">
        UPDATE redemption_codes
        SET used = 1,
        used_by = #{usedBy},
        used_at = #{usedAt}
        WHERE id = #{id}
    </update>

</mapper>
