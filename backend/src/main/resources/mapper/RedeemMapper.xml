<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.campbooking.g.mapper.RedeemMapper">

    <resultMap id="CouponResultMap" type="com.example.campbooking.g.entity.Coupon">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="type" property="type"/>
        <result column="valid_days" property="validDays"/>
    </resultMap>

    <resultMap id="UserCouponResultMap" type="com.example.campbooking.g.entity.UserCoupon">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="coupon_id" property="couponId"/>
        <result column="coupon_title" property="couponTitle"/>
        <result column="status" property="status"/>
        <result column="received_at" property="receivedAt"/>
        <result column="used_at" property="usedAt"/>
        <result column="expire_at" property="expireAt"/>
    </resultMap>

    <!-- 按 coupons.id 查券模板（兑换码表 code_value 存的即是优惠券 id） -->
    <select id="selectCouponById" resultMap="CouponResultMap" parameterType="java.lang.Long">
        SELECT id, title, type, valid_days
        FROM coupons
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- coupon_title 为 NOT NULL；received_at 有默认值，不写 -->
    <insert id="insertUserCoupon" parameterType="com.example.campbooking.g.entity.UserCoupon"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_coupons (user_id, coupon_id, coupon_title, status, expire_at)
        VALUES (#{userId}, #{couponId}, #{couponTitle}, #{status}, #{expireAt})
    </insert>

    <!-- 积分流水兜底写入：F 的 PointsRecordMapper 未并入前由 G 直写 points_records。
         type 固定 'earn'，created_at 走数据库默认值；列与 F 实体一致，F 查询接口可直接读到 -->
    <insert id="insertPointsRecord">
        INSERT INTO points_records (user_id, amount, type, source, remark)
        VALUES (#{userId}, #{amount}, 'earn', #{source}, #{remark})
    </insert>

</mapper>
