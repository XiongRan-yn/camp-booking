<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.campbooking.g.mapper.FavoriteMapper">

    <resultMap id="BaseResultMap" type="com.example.campbooking.g.entity.Favorite">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="created_at" property="createdAt"/>
        <result column="target_title" property="targetTitle"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT f.id, f.user_id, f.target_type, f.target_id, f.created_at, p.title AS target_title
        FROM favorites f
        LEFT JOIN products p ON p.id = f.target_id
        WHERE f.user_id = #{userId}
        ORDER BY f.id DESC
    </select>

</mapper>
